{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "command": "echo \"$CLAUDE_FILE_PATH\" | grep -qE '\\.(js|ts|tsx|jsx)$' && npx eslint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
      },
      {
        "matcher": "Edit",
        "command": "echo \"$CLAUDE_FILE_PATH\" | grep -qE '\\.(js|ts|tsx|jsx)$' && npx eslint --fix \"$CLAUDE_FILE_PATH\" 2>/dev/null || true"
      }
    ]
  }
}